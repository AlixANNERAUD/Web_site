---
interface Props {
  lang: "en" | "fr";
}

const { lang } = Astro.props;
const fr = lang === "fr";

const copy = fr
  ? {
      index: "01 / Introduction",
      discipline: "Ingénierie logicielle · Systèmes · Sécurité",
      name: "Alix ANNERAUD",
      job: "Ingénieur logiciel",
      lineOne: "Logiciel, systèmes",
      lineTwo: "& sécurité.",
      summary:
        "Je développe des systèmes Rust et des outils web, du prototype à la production. Mes expériences en sécurité, développement logiciel, réseaux et recherche nourrissent mes projets open source.",
      explore: "Mon parcours",
      projects: "Mes projets",
      contact: "Me contacter",
      scroll: "Défiler pour découvrir mon parcours",
      scrollLabel: "Découvrir la suite",
      footnote: "Concevoir · Construire · Exploiter",
    }
  : {
      index: "01 / Introduction",
      discipline: "Software engineering · Systems · Security",
      name: "Alix ANNERAUD",
      job: "Software engineer",
      lineOne: "Software, systems",
      lineTwo: "& security.",
      summary:
        "I build Rust systems and web tools, from prototypes to production. My experience across security, software engineering, networking and research informs the open-source projects I work on.",
      explore: "My experience",
      projects: "My projects",
      contact: "Get in touch",
      scroll: "Scroll to discover my experience",
      scrollLabel: "Explore further",
      footnote: "Design · Build · Operate",
    };

const actions = [
  {
    label: copy.explore,
    href: fr ? "/fr/experiences" : "/experiences",
    primary: true,
  },
  {
    label: copy.projects,
    href: fr ? "/fr/projects" : "/projects",
    primary: false,
  },
  { label: copy.contact, href: "mailto:alix@anneraud.fr", primary: false },
];
---

<section class="home-hero" aria-labelledby="home-hero-title">
  <div class="home-hero-inner">
    <div class="home-hero-overline" aria-hidden="true">
      <span class="home-hero-overline-index">{copy.index}</span>
      <span class="home-hero-overline-discipline">{copy.discipline}</span>
    </div>

    <div class="home-hero-content">
      <p class="home-hero-name">
        <span>{copy.name}</span>
        <span class="home-hero-name-divider" aria-hidden="true"></span>
        <span>{copy.job}</span>
      </p>

      <h1 id="home-hero-title" class="home-hero-title">
        <span class="home-hero-title-mask">
          <span class="home-hero-title-line">{copy.lineOne}</span>
        </span>
        <span class="home-hero-title-mask">
          <span class="home-hero-title-line home-hero-title-line--accent">
            <em>{copy.lineTwo}</em>
          </span>
        </span>
      </h1>

      <div class="home-hero-bottom-row">
        <p class="home-hero-tagline">{copy.summary}</p>
        <nav
          class="home-hero-actions"
          aria-label={fr ? "Liens principaux" : "Primary links"}
        >
          {actions.map((action) => (
            <a
              href={action.href}
              class:list={[
                "home-action",
                { "home-action--primary": action.primary },
              ]}
            >
              {action.label}
              <span class="home-action-icon" aria-hidden="true">
                ↗
              </span>
            </a>
          ))}
        </nav>
      </div>
    </div>

    <div class="home-hero-footer">
      <a
        class="home-hero-scroll"
        href="#career-highlights"
        aria-label={copy.scroll}
      >
        <span class="home-hero-scroll-icon" aria-hidden="true">
          ↓
        </span>
        <span>{copy.scrollLabel}</span>
      </a>
      <span class="home-hero-footer-note" aria-hidden="true">
        {copy.footnote}
      </span>
    </div>
  </div>
</section>

<style>
  /* Full-screen typographic introduction: no portraits, videos, WebGL or JS. */
  .home-hero {
    position: relative;
    display: flex;
    min-height: calc(100svh - 3.75rem);
    isolation: isolate;
    overflow: clip;
    border-bottom: 1px solid var(--vp-c-divider);
    color: var(--vp-c-text-1);
  }

  /* A restrained wash replaces the previous image's halo without reading as artwork. */
  .home-hero::before {
    content: "";
    position: absolute;
    z-index: -1;
    inset: 0;
    pointer-events: none;
    background: radial-gradient(
      ellipse 56% 60% at 82% 47%,
      color-mix(in srgb, var(--vp-c-brand-1) 7%, transparent) 0%,
      transparent 78%
    );
  }

  .home-hero-inner {
    display: flex;
    flex-direction: column;
    width: min(100%, 1180px);
    min-width: 0;
    margin-inline: auto;
    padding: clamp(1.35rem, 3.6vh, 2.25rem) 1.5rem clamp(1.4rem, 3.3vh, 2rem);
  }

  .home-hero-overline {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 1rem 2rem;
    padding-bottom: 0.95rem;
    position: relative;
    color: var(--vp-c-text-2);
    font-size: 0.67rem;
    font-weight: 650;
    letter-spacing: 0.145em;
    line-height: 1.5;
    text-transform: uppercase;
  }

  .home-hero-overline::after {
    content: "";
    position: absolute;
    inset: auto 0 0;
    height: 1px;
    background: var(--vp-c-divider);
    transform-origin: left;
  }

  .home-hero-content {
    display: grid;
    align-content: center;
    flex: 1;
    min-width: 0;
    padding-block: clamp(2.5rem, 6vh, 6rem);
  }

  .home-hero-name {
    display: flex;
    align-items: center;
    flex-wrap: wrap;
    gap: 0.5rem 0.9rem;
    margin: 0 0 clamp(1.15rem, 2.5vh, 2rem);
    color: var(--vp-c-text-2);
    font-size: clamp(0.73rem, 1.4vw, 0.89rem);
    font-weight: 600;
    letter-spacing: 0.04em;
    line-height: 1.5;
  }
  .home-hero-name-divider {
    display: inline-block;
    width: 1.25rem;
    height: 1px;
    background: var(--vp-c-brand-1);
  }

  .home-hero-title {
    margin: 0;
    padding: 0;
    border: 0;
    font-family: Georgia, "Times New Roman", serif;
    font-size: clamp(3.25rem, 7.25vw, 7.45rem);
    font-weight: 400;
    line-height: 1.045;
    letter-spacing: -0.066em;
  }

  .home-hero-title-mask {
    display: block;
    overflow: hidden;
    padding-right: 0.04em;
    padding-bottom: 0.05em;
    margin-bottom: -0.05em;
  }

  .home-hero-title-line {
    display: block;
    max-width: 100%;
    overflow-wrap: normal;
  }
  .home-hero-title-line em {
    color: var(--vp-c-brand-1);
    font-weight: 400;
    font-style: italic;
  }

  .home-hero-bottom-row {
    display: flex;
    align-items: end;
    justify-content: space-between;
    flex-wrap: wrap;
    gap: 1.5rem 2.5rem;
    margin-top: clamp(1.3rem, 3.8vh, 2.8rem);
  }

  .home-hero-tagline {
    flex: 1 1 25rem;
    max-width: 39rem;
    min-width: 0;
    margin: 0;
    color: var(--vp-c-text-2);
    font-size: clamp(0.9rem, 1.25vw, 1.02rem);
    line-height: 1.75;
  }

  .home-hero-actions {
    display: flex;
    flex: 0 1 auto;
    flex-wrap: wrap;
    gap: 0.55rem;
  }
  .home-action {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    gap: 0.5rem;
    min-height: 2.65rem;
    padding: 0.65rem 0.95rem;
    border: 1px solid var(--vp-c-divider);
    border-radius: 0.45rem;
    background: var(--vp-c-bg-soft);
    color: var(--vp-c-text-1);
    font-size: 0.84rem;
    font-weight: 620;
    text-decoration: none;
    white-space: nowrap;
    transition:
      border-color 170ms ease,
      background-color 170ms ease,
      color 170ms ease;
  }
  .home-action--primary {
    border-color: var(--vp-c-brand-1);
    background: var(--vp-c-brand-1);
    color: var(--vp-c-bg);
  }
  .home-action:hover {
    border-color: var(--vp-c-brand-1);
  }
  .home-action-icon {
    display: inline-block;
    transition: transform 200ms cubic-bezier(0.22, 1, 0.36, 1);
  }
  .home-action:hover .home-action-icon {
    transform: translate(2px, -2px);
  }

  .home-hero-footer {
    display: flex;
    justify-content: space-between;
    align-items: end;
    flex-wrap: wrap;
    gap: 1rem 2rem;
    padding-top: 1.05rem;
    border-top: 1px solid var(--vp-c-divider);
    color: var(--vp-c-text-2);
    font-size: 0.71rem;
    font-weight: 600;
    letter-spacing: 0.055em;
  }
  .home-hero-scroll {
    display: inline-flex;
    align-items: center;
    gap: 0.7rem;
    color: var(--vp-c-text-2);
    text-decoration: none;
  }
  .home-hero-scroll:hover {
    color: var(--vp-c-brand-1);
  }
  .home-hero-scroll-icon {
    display: grid;
    place-items: center;
    width: 2rem;
    height: 2rem;
    border: 1px solid var(--vp-c-divider);
    border-radius: 50%;
    color: var(--vp-c-brand-1);
    font-size: 1rem;
    line-height: 1;
  }
  .home-hero-footer-note {
    font-size: 0.65rem;
    text-transform: uppercase;
    letter-spacing: 0.12em;
  }

  /* All entrance motion is declarative: server-rendered text remains readable
     without JavaScript, and nothing loops except the tiny scroll arrow. */
  @keyframes hero-type-up {
    from {
      opacity: 0;
      transform: translate3d(0, 112%, 0);
    }
    to {
      opacity: 1;
      transform: translate3d(0, 0, 0);
    }
  }
  @keyframes hero-fade-in {
    from {
      opacity: 0;
      transform: translate3d(0, 13px, 0);
    }
    to {
      opacity: 1;
      transform: translate3d(0, 0, 0);
    }
  }
  @keyframes hero-rule-grow {
    from {
      transform: scaleX(0);
    }
    to {
      transform: scaleX(1);
    }
  }
  @keyframes hero-scroll-hint {
    0%,
    100% {
      transform: translateY(0);
    }
    50% {
      transform: translateY(4px);
    }
  }

  @media (prefers-reduced-motion: no-preference) {
    .home-hero-overline::after {
      animation: hero-rule-grow 1000ms cubic-bezier(0.22, 1, 0.36, 1) both;
    }
    .home-hero-title-line {
      animation: hero-type-up 900ms cubic-bezier(0.22, 1, 0.36, 1) both;
    }
    .home-hero-title-mask:nth-child(1) .home-hero-title-line {
      animation-delay: 150ms;
    }
    .home-hero-title-mask:nth-child(2) .home-hero-title-line {
      animation-delay: 295ms;
    }
    .home-hero-overline-index,
    .home-hero-overline-discipline,
    .home-hero-name,
    .home-hero-tagline,
    .home-hero-actions,
    .home-hero-footer {
      animation: hero-fade-in 680ms cubic-bezier(0.22, 1, 0.36, 1) both;
    }
    .home-hero-overline-index {
      animation-delay: 40ms;
    }
    .home-hero-overline-discipline {
      animation-delay: 120ms;
    }
    .home-hero-name {
      animation-delay: 110ms;
    }
    .home-hero-tagline {
      animation-delay: 480ms;
    }
    .home-hero-actions {
      animation-delay: 575ms;
    }
    .home-hero-footer {
      animation-delay: 745ms;
    }
    .home-hero-scroll-icon {
      animation: hero-scroll-hint 2200ms ease-in-out 1500ms infinite;
    }
  }

  @media (max-width: 940px) {
    .home-hero-title {
      font-size: clamp(3.25rem, 8.4vw, 6.25rem);
    }
    .home-hero-bottom-row {
      align-items: start;
    }
  }
  @media (max-width: 720px) {
    .home-hero {
      min-height: calc(100svh - 6.5rem);
    }
    .home-hero-inner {
      padding: 1.1rem 1rem 1.15rem;
    }
    .home-hero-overline-discipline {
      display: none;
    }
    .home-hero-content {
      padding-block: 2.25rem 2.75rem;
    }
    .home-hero-title {
      font-size: clamp(2.78rem, 10.3vw, 4.75rem);
      letter-spacing: -0.055em;
    }
    .home-hero-bottom-row {
      gap: 1.2rem;
      margin-top: 1.65rem;
    }
    .home-hero-tagline {
      flex-basis: 100%;
    }
    .home-hero-actions {
      width: 100%;
    }
    .home-hero-footer-note {
      display: none;
    }
  }
  @media (max-width: 380px) {
    .home-hero-title {
      font-size: 2.8rem;
    }
    .home-hero-actions {
      gap: 0.4rem;
    }
    .home-action {
      padding: 0.55rem 0.68rem;
      font-size: 0.78rem;
    }
    .home-hero-footer {
      padding-top: 0.85rem;
    }
  }
  @media (prefers-reduced-motion: reduce) {
    .home-hero *,
    .home-hero::before,
    .home-hero-overline::after {
      animation: none !important;
      transition: none !important;
    }
  }
</style>
